# Runtime
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Set to true when Express is behind a trusted HTTPS reverse proxy (recommended on Vercel).
# On Vercel, trust proxy is also enabled automatically when VERCEL=1.
TRUST_PROXY=false

# Generate unique values; never commit the populated .env file.
SESSION_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes).
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 web application credentials (Sheets backend connection only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google account allowed to authorize Sheets access (not used for panel login).
ADMIN_EMAIL=

# Panel admin login (ID + Argon2id password hash). Never store plaintext passwords.
ADMIN_LOGIN_ID=
# Generate with: node -e "require('argon2').hash('YOUR_PASSWORD').then(console.log)"
ADMIN_PASSWORD_HASH=

# Optional local override. When unset, local development uses SQLite in ./data.
# Required on Vercel for persistent storage of users, sessions, and projects.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=
