# Runtime
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Set to true when Express is behind a trusted HTTPS reverse proxy (recommended on Vercel).
# On Vercel, trust proxy is also enabled automatically when VERCEL=1.
TRUST_PROXY=false

# Generate unique values; never commit the populated .env file.
SESSION_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes).
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 web application credentials (Sheets backend connection only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google account allowed to authorize Sheets access (not used for panel login).
ADMIN_EMAIL=

# Panel admin login (ID + Argon2id password hash). Never store plaintext passwords.
ADMIN_LOGIN_ID=
# Generate with: node -e "require('argon2').hash('YOUR_PASSWORD').then(console.log)"
ADMIN_PASSWORD_HASH=

# Optional local override. When unset, local development uses SQLite in ./data.
# Required on Vercel for persistent storage of users, sessions, and projects.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Optional public legal/contact placeholders for Privacy Policy and Terms pages.
# Replace before App Store / Google Play submission. These are not secrets.
# PRIVACY_CONTACT_EMAIL=
# SUPPORT_EMAIL=
# LEGAL_BUSINESS_NAME=
# PUBLIC_LEGAL_BASE_URL=https://lead-admin-panel.vercel.app

# Website Android APK download (public, not a secret):
# Set ANDROID_APP_DOWNLOAD_URL in public/site-config.js to the official HTTPS APK URL.
# Do not invent a URL; leave empty until the APK is hosted.

# Production notes (Vercel / store builds):
# - Set NODE_ENV=production
# - Set BASE_URL=https://lead-admin-panel.vercel.app (or your confirmed HTTPS origin)
# - Set GOOGLE_REDIRECT_URI=https://<same-origin>/api/auth/google/callback
# - Mobile production builds use EXPO_PUBLIC_API_BASE_URL / EXPO_PUBLIC_LEGAL_BASE_URL
#   (see mobile/.env.example and mobile/eas.json). Never put server secrets in mobile env.
