# Runtime
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Set to true only when Express is behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false

# Generate unique values; never commit the populated .env file.
SESSION_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes).
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# The sole Google account allowed to administer this application.
ADMIN_EMAIL=
