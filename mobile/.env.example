# CHATURX mobile — public API URL only (no secrets).
#
# Simulator / Expo web against local backend:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
#
# Physical device on the same LAN (replace with your Mac's IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
#
# Production HTTPS API:
# EXPO_PUBLIC_API_BASE_URL=https://your-api-host.example

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
